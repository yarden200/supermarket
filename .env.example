# Copy this file to .env and replace the placeholder values.

# PostgreSQL admin (used only by the init script)
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket_admin
POSTGRES_PASSWORD=your-admin-password

# product-service database
PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=your-product-db-password

# order-service database
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=your-order-db-password

# auth-service database
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=your-auth-db-password

# customer-service database
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=your-customer-db-password

JWT_SECRET=your-jwt-secret-at-least-32-characters

# Seed users created by auth-service on startup
SEED_ADMIN_PASSWORD=password
SEED_USER_PASSWORD=password

# S3 (real AWS: S3_ENDPOINT empty; LocalStack: http://localhost:4566)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=supermarket-images
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=