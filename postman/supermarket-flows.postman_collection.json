{
  "info": {
    "name": "Supermarket - flows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flows 1-4 from the project document, through the gateway (docker compose). Run the whole collection in order. The setup folder creates its own category and products, so the collection works on any database. Set adminPassword and userPassword to the seed passwords from .env. Flow 5 (Kubernetes) has its own collection."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "adminPassword",
      "value": "your-admin-password"
    },
    {
      "key": "userPassword",
      "value": "your-user-password"
    },
    {
      "key": "categoryName",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "milkSku",
      "value": ""
    },
    {
      "key": "milkId",
      "value": ""
    },
    {
      "key": "breadSku",
      "value": ""
    },
    {
      "key": "breadId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "newSku",
      "value": ""
    },
    {
      "key": "newProductId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup - demo data",
      "item": [
        {
          "name": "Logout (204)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Start as a guest (clears any old cookie)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Admin login - needed to create the demo data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "description": "Creates a new category for this run; its id is used in the flows.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{categoryName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"categoryName\", \"Dairy \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product: milk (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "description": "Product found by the search for 'milk' in Flow 1 and ordered in Flow 2.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{milkSku}}\",\n  \"name\": \"Milk 3%\",\n  \"description\": \"Fresh milk, 1 liter\",\n  \"price\": 6.90,\n  \"stockQuantity\": 50,\n  \"categoryId\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"milkSku\", \"MILK-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"milkId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product: bread (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "description": "Second product ordered in Flow 2.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{breadSku}}\",\n  \"name\": \"Whole wheat bread\",\n  \"description\": \"Fresh bread\",\n  \"price\": 12.50,\n  \"stockQuantity\": 30,\n  \"categoryId\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"breadSku\", \"BREAD-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"breadId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (204)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Logout - removes the auth cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flow 1 - Guest browsing the catalog",
      "item": [
        {
          "name": "Products of a category (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?categoryId={{categoryId}}",
            "description": "Guest lists the products of one category (public)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().content.map(p => p.id);",
                  "pm.test(\"Both products of the category are returned\", () => pm.expect(ids).to.include.members([Number(pm.collectionVariables.get(\"milkId\")), Number(pm.collectionVariables.get(\"breadId\"))]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search 'milk' (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/search/products?q=milk",
            "description": "Guest searches through Elasticsearch (public). Waits 2 seconds first so search-service can index the new products from Kafka."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const list = Array.isArray(b) ? b : (b.content || []);",
                  "pm.test(\"At least one result\", () => pm.expect(list.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Guest cannot place an order (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "description": "A guest has no cookie, so the gateway rejects the order.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [ { \"productId\": {{milkId}}, \"quantity\": 1 } ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flow 2 - Customer places an order",
      "item": [
        {
          "name": "Login as user (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Customer login - returns 200 and sets the auth cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Place an order (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "description": "Orders 2 milk + 1 bread. Response has the total and the remaining stock. In the logs: the OrderCreated event goes to Kafka and search-service updates the sold count.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": {{milkId}}, \"quantity\": 2 },\n    { \"productId\": {{breadId}}, \"quantity\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", o.id);",
                  "pm.test(\"Total is 2 x 6.90 + 12.50 = 26.30\", () => pm.expect(Number(o.totalPrice)).to.eql(26.3));",
                  "pm.test(\"Milk stock went down from 50 to 48\", () => pm.expect(o.items.find(i => i.productId === Number(pm.collectionVariables.get(\"milkId\"))).remainingStock).to.eql(48));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same customer reads the order (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}",
            "description": "The customer who placed the order can read it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (204)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Logout - removes the auth cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as user2 (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Login as a different customer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user2\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Different customer cannot read the order (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}",
            "description": "Another customer is rejected by order-service (@PreAuthorize owner check)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (204)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Logout - removes the auth cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flow 3 - Admin manages inventory",
      "item": [
        {
          "name": "Login as admin (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Admin login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "description": "Admin creates a product. The ProductCreated event goes to Kafka and search-service indexes it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{newSku}}\",\n  \"name\": \"Cheddar cheese\",\n  \"description\": \"Aged cheese\",\n  \"price\": 24.90,\n  \"stockQuantity\": 15,\n  \"categoryId\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newSku\", \"CHEESE-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"newProductId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products/{{newProductId}}",
            "description": "Admin updates the product (new price).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{newSku}}\",\n  \"name\": \"Cheddar cheese\",\n  \"description\": \"Aged cheese\",\n  \"price\": 21.90,\n  \"stockQuantity\": 15,\n  \"categoryId\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Price updated\", () => pm.expect(Number(pm.response.json().price)).to.eql(21.9));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change order status to SHIPPED (200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders/{{orderId}}/status",
            "description": "Admin changes the status of the order from Flow 2.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is SHIPPED\", () => pm.expect(pm.response.json().status).to.eql(\"SHIPPED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete product (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{newProductId}}",
            "description": "Admin deletes the product created in this flow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "List all orders (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders",
            "description": "Admin sees the orders of all customers."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"At least one order\", () => pm.expect(pm.response.json().content.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (204)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Logout - removes the auth cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flow 4 - Defense in depth",
      "item": [
        {
          "name": "Delete without a cookie (401 from the gateway)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{milkId}}",
            "description": "No cookie: the gateway rejects the request before it reaches product-service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Rejected by the gateway\", () => pm.expect(pm.response.json().detail).to.eql(\"Authentication required\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as user (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Login as a regular user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete as a regular user (403 from product-service)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{milkId}}",
            "description": "The gateway lets the logged-in user through, and product-service rejects it (@PreAuthorize hasRole ADMIN). Both layers work."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (204)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Logout - removes the auth cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}