        {
          "name": "Document fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/search/products?categoryId={{dairyId}}&size=100",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "search",
                "products"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{dairyId}}"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const milk = pm.response.json().content.find(d => Number(d.id) === Number(pm.collectionVariables.get(\"milkId\")));",
                  "pm.test(\"Has category name, price and stock\", () => { pm.expect(milk.categoryName).to.include(\"Dairy\"); pm.expect(milk.price).to.eql(6.9); pm.expect(milk.stockQuantity).to.eql(50); pm.expect(milk.soldCount).to.eql(0); });"
                ]
