    {
      "name": "2. Search (guest)",
      "item": [
        {
          "name": "Logout - search is public",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/logout",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// give search-service time to consume the events and Elasticsearch time to refresh",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search 'milk' - name matches first, description later",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/search/products?q=milk&size=100",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "search",
                "products"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "milk"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().content.map(d => Number(d.id));",
                  "const v = n => Number(pm.collectionVariables.get(n));",
                  "pm.test(\"Finds both milk products\", () => { pm.expect(ids).to.include(v(\"milkId\")); pm.expect(ids).to.include(v(\"chocoId\")); });",
                  "pm.test(\"Finds bread via description\", () => pm.expect(ids).to.include(v(\"breadId\")));",
                  "pm.test(\"Name matches rank above description match\", () => pm.expect(ids.indexOf(v(\"milkId\"))).to.be.below(ids.indexOf(v(\"breadId\"))));",
                  "pm.test(\"Cheese not returned\", () => pm.expect(ids).to.not.include(v(\"cheeseId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search with a typo 'chese' (fuzziness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/search/products?q=chese&size=100",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "search",
                "products"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "chese"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().content.map(d => Number(d.id));",
                  "const v = n => Number(pm.collectionVariables.get(n));",
                  "pm.test(\"Finds Cheddar Cheese\", () => pm.expect(ids).to.include(v(\"cheeseId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Category only - all Dairy products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/search/products?categoryId={{dairyId}}&size=100",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
