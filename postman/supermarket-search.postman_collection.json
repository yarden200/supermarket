                  "pm.test(\"Exactly the 3 dairy products\", () => { pm.expect(ids.length).to.eql(3); [v(\"milkId\"), v(\"chocoId\"), v(\"cheeseId\")].forEach(id => pm.expect(ids).to.include(id)); });"
                ]
