{
  "info": {
    "name": "Supermarket - search-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "End-to-end search tests through the gateway: products are created via product-service, events flow through Kafka, search-service indexes them in Elasticsearch. Some requests wait 3 seconds for indexing. Run the whole collection in order."
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "userPassword",
      "value": "your-user-password"
    },
    {
      "key": "adminPassword",
      "value": "your-admin-password"
    },
    {
      "key": "run",
      "value": ""
    },
    {
      "key": "dairyId",
      "value": ""
    },
    {
      "key": "bakeryId",
      "value": ""
    },
    {
      "key": "milkId",
      "value": ""
    },
    {
      "key": "chocoId",
      "value": ""
    },
    {
      "key": "cheeseId",
      "value": ""
    },
    {
      "key": "breadId",
      "value": ""
    },
    {
      "key": "skuMilk",
      "value": ""
    },
    {
      "key": "skuChoco",
      "value": ""
    },
    {
      "key": "skuCheese",
      "value": ""
    },
    {
      "key": "skuBread",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup (admin)",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category Dairy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/categories",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dairy {{run}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"run\", Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"dairyId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category Bakery",
