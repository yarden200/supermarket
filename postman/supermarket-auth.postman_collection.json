{
  "info": {
    "name": "Supermarket - auth-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "auth-service tests. Postman keeps the ACCESS_TOKEN cookie between requests automatically. Set userPassword and adminPassword to the seed passwords from your .env."
  },
  "variable": [
    {
      "key": "authUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "userPassword",
      "value": "password"
    },
    {
      "key": "adminPassword",
      "value": "password"
    },
    {
      "key": "newUsername",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register, me, logout",
      "item": [
        {
          "name": "Register new user (201 + cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/register",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newUsername\", \"dana_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "pm.test(\"ACCESS_TOKEN cookie is set\", () => pm.expect(setCookie).to.include(\"ACCESS_TOKEN=\"));",
                  "pm.test(\"Cookie is HttpOnly\", () => pm.expect(setCookie).to.include(\"HttpOnly\"));",
                  "pm.test(\"Cookie is SameSite=Strict\", () => pm.expect(setCookie).to.include(\"SameSite=Strict\"));",
                  "const u = pm.response.json();",
                  "pm.test(\"Username returned\", () => pm.expect(u.username).to.eql(pm.collectionVariables.get(\"newUsername\")));",
                  "pm.test(\"Only USER role\", () => pm.expect(u.roles).to.eql([\"USER\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me after register (logged in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/me",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Me is the new user\", () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"newUsername\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register same username again (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/register",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/register",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"a!\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"username and password errors\", () => { const e = pm.response.json().errors; pm.expect(e).to.have.property(\"username\"); pm.expect(e).to.have.property(\"password\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (204, cookie cleared)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/logout",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"Cookie expired\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"Max-Age=0\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me after logout (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/me",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Login",
      "item": [
        {
          "name": "Login as user (200 + cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "pm.test(\"ACCESS_TOKEN cookie is set\", () => pm.expect(setCookie).to.include(\"ACCESS_TOKEN=\"));",
                  "pm.test(\"Cookie is HttpOnly\", () => pm.expect(setCookie).to.include(\"HttpOnly\"));",
                  "pm.test(\"Cookie is SameSite=Strict\", () => pm.expect(setCookie).to.include(\"SameSite=Strict\"));",
                  "pm.test(\"Roles: USER\", () => pm.expect(pm.response.json().roles).to.eql([\"USER\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me as user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/me",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Me is user\", () => pm.expect(pm.response.json().username).to.eql(\"user\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin (200 + cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "pm.test(\"ACCESS_TOKEN cookie is set\", () => pm.expect(setCookie).to.include(\"ACCESS_TOKEN=\"));",
                  "pm.test(\"Cookie is HttpOnly\", () => pm.expect(setCookie).to.include(\"HttpOnly\"));",
                  "pm.test(\"Cookie is SameSite=Strict\", () => pm.expect(setCookie).to.include(\"SameSite=Strict\"));",
                  "pm.test(\"Roles: ADMIN and USER\", () => pm.expect(pm.response.json().roles).to.eql([\"ADMIN\", \"USER\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me as admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/me",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Me is admin\", () => pm.expect(pm.response.json().username).to.eql(\"admin\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Generic message\", () => pm.expect(pm.response.json().detail).to.eql(\"Invalid username or password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login unknown user (401, same message)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nobody\",\n  \"password\": \"whatever123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Generic message\", () => pm.expect(pm.response.json().detail).to.eql(\"Invalid username or password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login missing fields (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/logout",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}