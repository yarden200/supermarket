{
  "info": {
    "name": "Supermarket - order-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Self-contained order-service tests. Both product-service (8080) and order-service (8081) must be running. Run folders 1-4 together; run folder 5 alone, after stopping product-service."
  },
  "variable": [
    {
      "key": "productUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "orderUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "orderCategoryId",
      "value": ""
    },
    {
      "key": "productA",
      "value": ""
    },
    {
      "key": "productB",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup (product-service)",
      "item": [
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/api/categories",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Order Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"orderCategoryId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product A (price 10.00, stock 10)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/api/products",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"ORDER-A\",\n  \"name\": \"Product A\",\n  \"description\": \"Order test product\",\n  \"price\": 10.0,\n  \"stockQuantity\": 10,\n  \"categoryId\": {{orderCategoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"productA\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product B (price 25.50, stock 5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/api/products",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"ORDER-B\",\n  \"name\": \"Product B\",\n  \"description\": \"Order test product\",\n  \"price\": 25.5,\n  \"stockQuantity\": 5,\n  \"categoryId\": {{orderCategoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"productB\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Orders - success",
      "item": [
        {
          "name": "Create order (A x2, B x1, A x1 again)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{orderUrl}}/api/orders",
              "host": [
                "{{orderUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    { \"productId\": {{productA}}, \"quantity\": 2 },\n    { \"productId\": {{productB}}, \"quantity\": 1 },\n    { \"productId\": {{productA}}, \"quantity\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"orderId\", pm.response.json().id);",
                  "const o = pm.response.json();",
                  "pm.test(\"Location header points to the order\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/orders/\" + o.id));",
                  "pm.test(\"Status is PENDING\", () => pm.expect(o.status).to.eql(\"PENDING\"));",
                  "pm.test(\"Total is 55.50 (3 x 10.00 + 25.50)\", () => pm.expect(o.totalPrice).to.eql(55.5));",
                  "pm.test(\"Duplicate product merged: 2 lines\", () => pm.expect(o.items.length).to.eql(2));",
                  "const a = o.items.find(i => i.productId == pm.collectionVariables.get(\"productA\"));",
                  "const b = o.items.find(i => i.productId == pm.collectionVariables.get(\"productB\"));",
                  "pm.test(\"A: quantity 3, name and price from product-service\", () => { pm.expect(a.quantity).to.eql(3); pm.expect(a.productName).to.eql(\"Product A\"); pm.expect(a.priceAtPurchase).to.eql(10); pm.expect(a.lineTotal).to.eql(30); });",
                  "pm.test(\"Remaining stock: A 7, B 4\", () => { pm.expect(a.remainingStock).to.eql(7); pm.expect(b.remainingStock).to.eql(4); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order by id (no remainingStock)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{orderUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "pm.test(\"Two items\", () => pm.expect(o.items.length).to.eql(2));",
                  "pm.test(\"remainingStock not returned\", () => pm.expect(o.items[0]).to.not.have.property(\"remainingStock\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check product A stock is 7",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productUrl}}/api/products/{{productA}}",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productA}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"A stock is 7\", () => pm.expect(pm.response.json().stockQuantity).to.eql(7));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all orders (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderUrl}}/api/orders",
              "host": [
                "{{orderUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has content and page info\", () => { pm.expect(pm.response.json().content).to.be.an(\"array\"); pm.expect(pm.response.json().page).to.have.property(\"totalElements\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update status to SHIPPED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{orderUrl}}/api/orders/{{orderId}}/status",
              "host": [
                "{{orderUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is SHIPPED\", () => pm.expect(pm.response.json().status).to.eql(\"SHIPPED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update status back to PENDING (no transition rules)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{orderUrl}}/api/orders/{{orderId}}/status",
              "host": [
                "{{orderUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PENDING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is PENDING\", () => pm.expect(pm.response.json().status).to.eql(\"PENDING\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
